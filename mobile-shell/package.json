{
  "name": "ai2-mobile-shell",
  "private": true,
  "version": "1.0.0",
  "description": "手机app设计 — Capacitor 壳，将导出的 www 打成 Android APK",
  "scripts": {
    "sync": "npx cap sync android",
    "open": "npx cap open android",
    "build:apk": "cd android && .\\gradlew.bat assembleDebug",
    "build:apk:unix": "cd android && ./gradlew assembleDebug",
    "copy-apk": "node ../scripts/copy-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/camera": "^7.0.1",
    "@capacitor/core": "^7.4.2",
    "@capacitor/geolocation": "^7.1.4",
    "@capacitor/preferences": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "typescript": "~5.8.0"
  }
}
